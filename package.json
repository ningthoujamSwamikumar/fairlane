{
  "name": "ace-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "demo": "pnpm build && node ./apps/demo/demo.mjs",
    "relay": "pnpm build && node ./apps/relay/dist/server.js",
    "test": "pnpm build && node --test ./packages/client/dist/index.test.js ./apps/relay/dist/execution-adapter.test.js ./apps/relay/dist/policy-engine.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
